# GROQ_API_KEY: Required for Groq AI API calls (https://console.groq.com/keys)
# Store your Groq API key securely in server environment secrets.
GROQ_API_KEY="your_groq_api_key_here"

# GROQ_MODEL: Configurable Groq model (default: openai/gpt-oss-120b)
# Active verified production models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL="openai/gpt-oss-120b"

# PORT: Server port (default: 3000)
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
